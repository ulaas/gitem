pkgbase = gitem-bin
	pkgdesc = A fast desktop Git client with a commit graph, a repo-aware editor, and its own diff and merge tools
	pkgver = @VERSION@
	pkgrel = 1
	url = https://ulaas.github.io/gitem/
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = git
	depends = gcc-libs
	depends = glibc
	depends = libxkbcommon
	depends = wayland
	optdepends = vulkan-icd-loader: Vulkan rendering
	optdepends = mesa: OpenGL rendering
	optdepends = libx11: X11 sessions
	optdepends = libxcursor: X11 sessions
	optdepends = libxrandr: X11 sessions
	optdepends = libxi: X11 sessions
	optdepends = xdg-desktop-portal: file dialogs
	optdepends = libnotify: system notifications
	provides = gitem
	conflicts = gitem
	options = !strip
	options = !debug
	source = gitem-@VERSION@.desktop::https://raw.githubusercontent.com/ulaas/gitem/v@VERSION@/packaging/linux/gitem.desktop
	source = gitem-@VERSION@.png::https://raw.githubusercontent.com/ulaas/gitem/v@VERSION@/packaging/linux/gitem.png
	sha256sums = @SHA256_DESKTOP@
	sha256sums = @SHA256_ICON@
	source_x86_64 = https://github.com/ulaas/gitem/releases/download/v@VERSION@/gitem-@VERSION@-linux-x64.tar.gz
	sha256sums_x86_64 = @SHA256_LINUX_X64_TGZ@
	source_aarch64 = https://github.com/ulaas/gitem/releases/download/v@VERSION@/gitem-@VERSION@-linux-arm64.tar.gz
	sha256sums_aarch64 = @SHA256_LINUX_ARM64_TGZ@

pkgname = gitem-bin
